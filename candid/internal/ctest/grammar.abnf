; Entry Point
; Per the upstream README the root is <def>;* <test>;*.
TestData = 1*(Comment / Def / Test / EndLine / " " / %x09)

; DataType is the candid grammar's rule, bound by NewTestParser: the abnf
; generator cannot reference another grammar. Declared self-referentially here
; so it is emitted as a reference rather than inlined; the body is never used.
Def      = "type" 1*" " DefId *" " "=" Ws DefType *" " ";"
DefId    = (%x41-5A / %x61-7A / "_") *(%x41-5A / %x61-7A / %x30-39 / "_")
DefType  = DataType
DataType = DataType

; Comments
Comment      = ("/*" Ws MultiComment Ws "*/") 
             / ("//" [CommentText]) EndLine
CommentText  = *(%x00-09 / %x0B-0C / %x0E-D7FF / %xE000-10FFFF)
MultiComment  = *(%x00-29 / %x2B-10FFFF / (%x2A (%x00-2E / %x30-10FFFF)) / EndLine)

Ws      = *(" " / %x09 / EndLine)
EndLine = %x0A / %x0D / (%x0D %x0A)

; TestNotTmpl precedes TestBadTmpl: "!=" and "!:" share a prefix.
Test         = "assert " Input Ws (TestGoodTmpl / TestNotTmpl / TestBadTmpl / TestTest) [1*" " Description] ";"

; The input decodes at the given type.
TestGoodTmpl = ":" Ws TestGood
TestGood     = ValuesBr

; The input does not decode at the given type.
TestBadTmpl  = "!:" Ws TestBad
TestBad      = ValuesBr

; Both inputs decode at the given type, and the results are equal.
TestTest     = "==" Ws Input Ws ":" Ws ValuesBr

; Both inputs decode at the given type, and the results differ.
TestNotTmpl  = "!=" Ws TestNot
TestNot      = Input Ws ":" Ws ValuesBr

; The type an assertion is made at, in the full candid type language.
ValuesBr     = "()" / "(" Ws AnnType *("," Ws AnnType) Ws ")"
AnnType      = DataType

Input         = BlobInputTmpl / TextInputTmpl
TextInputTmpl = %x22 TextInput %x22
TextInput     = String

BlobInputTmpl = "blob " %x22 BlobInput %x22
BlobInput     = *(BlobAlpha / "\" BlobHex)
; Any printable literal byte except the quote and the escape introducer.
BlobAlpha = 1*(%x20-21 / %x23-5B / %x5D-7E)
BlobHex   = 2*2(%x30-39 / %x41-46 / %x61-66) ; 0-9 / A-F / a-f

Description = %x22 String %x22 ; "

String = *Char

Char          = EscapedDQuote / UChar
UChar         = %x20-21 / %x23-10FFFF  ; Any Unicode character except DQUOTE (")
EscapedDQuote = %x5C %x22

digit   = %x30-39 ; 0-9
hex     = digit / %x41-46 / %x61-66 ; A-F / a-f

